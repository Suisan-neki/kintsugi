{
  "name": "mugiurushi-review-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:repository-layout": "node tools/build-repository-layout.mjs",
    "test:external": "node tools/pinned-demo.mjs",
    "test:backend": "node tools/backend-demo.mjs",
    "test:app": "node tools/app-smoke.mjs",
    "test:dicom": "node tools/dicom-smoke.mjs",
    "test:browser": "node tools/browser-smoke.mjs",
    "test:browser-handoff": "node tools/browser-handoff-smoke.mjs",
    "test:reader-native": "node tools/reader-native-smoke.mjs",
    "demo:queue": "node tools/queue-demo.mjs",
    "test:journey": "node tools/journey-smoke.mjs",
    "test:dialogue": "node tools/dialogue-smoke.mjs",
    "test:user-trial": "node tools/user-trial-smoke.mjs",
    "test:ui": "npm run test:journey && npm run test:dialogue && npm run test:user-trial",
    "test:trial-plan": "node --test tools/openemr-trial-plan-tests.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ui",
    "test:api": "node --test tools/api-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "elkjs": "0.12.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
